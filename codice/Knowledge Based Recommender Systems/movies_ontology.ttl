        "http://dbpedia.org/resource/Kristy_Swanson",
        "http://dbpedia.org/resource/Matthew_Labyorteaux",
        "http://dbpedia.org/resource/Michael_Sharrett" ;
    dbp:released 1986 ;
    dbp:views 3 .

